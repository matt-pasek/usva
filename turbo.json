{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "docs#build": {
      "dependsOn": ["^build", "@usva-ui/cli#registry"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "!.next/turbopack/**",
        "!.next/diagnostics/**"
      ]
    },
    "registry": { "dependsOn": ["^build"], "outputs": ["../../registry/r/**"] },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "capture": {
      "dependsOn": ["build-storybook"],
      "outputs": ["captures/**"]
    },
    "lint": {},
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] }
  }
}
