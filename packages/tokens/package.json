{
  "name": "@usva-ui/tokens",
  "version": "1.0.1",
  "description": "The token layer for usva: semantic role tokens, three themes, a Tailwind v4 theme.css, and W3C DTCG plus Tokens Studio exports for Figma.",
  "keywords": [
    "design-tokens",
    "dtcg",
    "w3c-design-tokens",
    "tokens-studio",
    "figma",
    "tailwind",
    "tailwindcss",
    "tailwind-v4",
    "theming",
    "dark-mode",
    "css-variables",
    "design-system",
    "usva"
  ],
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://usva.build",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matt-pasek/usva.git",
    "directory": "packages/tokens"
  },
  "bugs": "https://github.com/matt-pasek/usva/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "theme.css",
    "themes",
    "README.md",
    "LICENSE.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./themes/kajo.css": "./themes/kajo.css",
    "./themes/sisu.css": "./themes/sisu.css",
    "./themes/savi.css": "./themes/savi.css",
    "./tokens.dtcg.json": "./dist/tokens.dtcg.json",
    "./tokens.studio.json": "./dist/tokens.studio.json",
    "./roles-safelist.css": "./dist/roles-safelist.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && bun run src/emit-dtcg.ts && bun run src/emit-safelist.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "vitest": "^2.1.0"
  }
}
