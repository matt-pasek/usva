{
  "name": "@matt-pasek/usva-tokens",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "sideEffects": ["*.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./preset": { "types": "./dist/preset.d.ts", "import": "./dist/preset.js" },
    "./theme.css": "./theme.css",
