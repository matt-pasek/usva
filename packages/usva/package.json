{
  "name": "@matt-pasek/usva",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cn": {
      "types": "./dist/cn.d.ts",
      "import": "./dist/cn.js"
    }
  },
  "scripts": {
    "build": "bunchee",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "capture": "bun run scripts/capture/index.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@matt-pasek/usva-tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^12.38.0",
    "ogl": "^1.0.11",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^9",
    "@storybook/addon-docs": "^9",
    "@storybook/react-vite": "^9",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest-axe": "^3.5.9",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "bunchee": "^6.0.0",
    "chromatic": "^18.0.1",
    "gifenc": "^1.0.3",
    "jest-axe": "^9.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0",
    "react": "^19",
    "react-dom": "^19",
    "storybook": "^9",
    "vitest": "^2.1.0"
  }
}
